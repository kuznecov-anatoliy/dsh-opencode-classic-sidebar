{
  "name": "dsh-opencode-classic-sidebar",
  "version": "0.1.0",
  "description": "The classic (pre-redesign) OpenCode sidebar layout for DeepSeek Harness: a project column next to the selected project's session list with pin, rename, fork, copy id and archive, an archive view, panel buttons in the Windows caption strip, and an account balance chip.",
  "type": "module",
  "license": "MIT",
  "author": "kuznecov-anatoliy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuznecov-anatoliy/dsh-opencode-classic-sidebar.git"
  },
  "homepage": "https://github.com/kuznecov-anatoliy/dsh-opencode-classic-sidebar#readme",
  "bugs": {
    "url": "https://github.com/kuznecov-anatoliy/dsh-opencode-classic-sidebar/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "sidebar",
    "sessions",
    "projects"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
