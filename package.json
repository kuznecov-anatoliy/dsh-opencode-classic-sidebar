{
  "name": "dsh-sidebar-suite",
  "version": "0.1.0",
  "description": "OpenCode-style DSH sidebar: a project column with a per-project session list and session actions, panel buttons moved into the Windows caption strip, and an account balance chip.",
  "type": "module",
  "license": "MIT",
  "author": "kuznecov-anatoliy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuznecov-anatoliy/dsh-sidebar-suite.git"
  },
  "homepage": "https://github.com/kuznecov-anatoliy/dsh-sidebar-suite#readme",
  "bugs": {
    "url": "https://github.com/kuznecov-anatoliy/dsh-sidebar-suite/issues"
  },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "sidebar", "sessions", "projects"],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
